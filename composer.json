{
    "name": "zerokyc/zerokyc-woocommerce",
    "description": "ZeroKYC Pay - crypto payments gateway for WooCommerce (development tooling only; the plugin has no runtime dependencies).",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "classmap": ["includes/", "vendor/zerokyc/zkp-sdk-php/src/"]
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
